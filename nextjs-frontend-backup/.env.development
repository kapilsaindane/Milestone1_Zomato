# Development Environment Variables
# For local development and testing

# Backend API Configuration (Local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend Configuration (Local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Restaurant Recommender (Dev)

# Environment Settings
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_SEO=true

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRIES=3

# Performance
NEXT_PUBLIC_ENABLE_BUNDLE_ANALYZER=true
NEXT_PUBLIC_ENABLE_IMAGE_OPTIMIZATION=true

# Security (Relaxed for development)
NEXT_PUBLIC_ENABLE_CSP=false
NEXT_PUBLIC_ENABLE_HSTS=false

# Debug Settings
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Custom Configuration
CUSTOM_KEY=development-key
