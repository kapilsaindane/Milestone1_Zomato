# Production Environment Variables
# Copy this file to .env.local and update with your actual values

# Backend API Configuration
NEXT_PUBLIC_API_URL=https://restaurant-recommender-api.onrender.com

# Frontend Configuration
NEXT_PUBLIC_APP_URL=https://your-project-name.vercel.app
NEXT_PUBLIC_APP_NAME=AI Restaurant Recommender

# Environment Settings
NODE_ENV=production

# Analytics (Optional - Add your actual IDs)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=VERCEL_ANALYTICS_ID

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_SEO=true

# API Configuration
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_API_RETRIES=3

# Performance
NEXT_PUBLIC_ENABLE_BUNDLE_ANALYZER=false
NEXT_PUBLIC_ENABLE_IMAGE_OPTIMIZATION=true

# Security
NEXT_PUBLIC_ENABLE_CSP=true
NEXT_PUBLIC_ENABLE_HSTS=true

# Custom Configuration
CUSTOM_KEY=your-production-custom-key
